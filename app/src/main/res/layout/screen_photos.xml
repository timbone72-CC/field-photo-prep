<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/photos_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_background">
    <LinearLayout
        android:id="@+id/photos_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <Button
                android:id="@+id/photos_back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:minWidth="0dp"
                android:text="‹"
                android:textAllCaps="false"
                android:textColor="@color/home_text_primary"
                android:textSize="22sp"
                style="@style/FieldAction" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Photos"
                android:textColor="@color/home_text_primary"
                style="@style/FieldAppTitle" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_concept_card"
            android:orientation="vertical"
            android:padding="12dp">
            <TextView
                android:id="@+id/photos_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/home_text_primary"
                android:textSize="14sp"
                android:textStyle="normal"
                android:fontFamily="sans-serif-medium" />
            <TextView
                android:id="@+id/photos_work_order"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/home_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
        <TextView
            android:id="@+id/photos_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_concept_status"
            android:padding="9dp"
            android:textColor="@color/home_error"
            android:textSize="12sp"
            android:visibility="gone" />
        <Button
            android:id="@+id/photos_open_camera"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_concept_blue_button"
            android:text="Open Camera"
            android:textAllCaps="false"
            android:textColor="@color/home_on_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            style="@style/FieldAction"
            android:drawableStart="@drawable/ic_field_camera"
            android:drawableTint="@color/home_on_primary"
            android:drawablePadding="8dp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/photos_pending_count"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Photos"
                android:textColor="@color/home_text_primary"
                android:textSize="15sp"
                android:textStyle="normal"
                android:fontFamily="sans-serif-medium" />
            <Button
                android:id="@+id/photos_select_all"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minWidth="0dp"
                android:text="Select All Ready"
                android:textAllCaps="false"
                android:textSize="12sp"
                style="@style/FieldAction"
                android:background="?android:attr/selectableItemBackground"
                android:textColor="@color/home_blue"
                android:paddingStart="6dp"
                android:paddingEnd="6dp" />
            <Button
                android:id="@+id/photos_clear_selection"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minWidth="0dp"
                android:text="Clear"
                android:textAllCaps="false"
                android:textSize="12sp"
                style="@style/FieldAction"
                android:background="?android:attr/selectableItemBackground"
                android:textColor="@color/home_text_secondary"
                android:paddingStart="6dp"
                android:paddingEnd="6dp" />
        </LinearLayout>
        <TextView
            android:id="@+id/photos_batch_selection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="5dp"
            android:textColor="@color/home_text_secondary"
            android:textSize="12sp" />
        <LinearLayout
            android:id="@+id/photos_selected_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_concept_card"
            android:orientation="vertical"
            android:padding="10dp"
            android:visibility="gone">
            <TextView
                android:id="@+id/photos_selected_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/home_text_primary"
                android:textSize="13sp"
                android:textStyle="normal"
                android:fontFamily="sans-serif-medium" />
            <TextView
                android:id="@+id/photos_prepared_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="@color/home_text_secondary"
                android:textSize="12sp" />
            <Button
                android:id="@+id/photos_prepare"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:text="Prepare selected photo"
                android:textAllCaps="false"
                android:visibility="gone"
                style="@style/FieldAction" />
            <Button
                android:id="@+id/photos_upload_one"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Upload this photo"
                android:textAllCaps="false"
                android:visibility="gone"
                style="@style/FieldAction" />
            <Button
                android:id="@+id/photos_reconcile"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Reconcile uncertain upload"
                android:textAllCaps="false"
                android:visibility="gone"
                style="@style/FieldAction" />
            <Button
                android:id="@+id/photos_discard"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Discard temporary photo"
                android:textAllCaps="false"
                android:visibility="gone"
                style="@style/FieldAction" />
        </LinearLayout>
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="8dp">
                <LinearLayout
                    android:id="@+id/photos_pending_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>
        <Button
            android:id="@+id/photos_upload_selected"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_concept_green_button"
            android:text="Upload Selected (0)"
            android:textAllCaps="false"
            android:textColor="@color/home_on_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            style="@style/FieldAction" />
        <include
            layout="@layout/field_bottom_navigation" />
    </LinearLayout>
</FrameLayout>
