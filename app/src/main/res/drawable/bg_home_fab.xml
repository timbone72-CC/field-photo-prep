<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/home_primary_pressed" />
            <corners android:radius="26dp" />
            <padding android:left="18dp" android:top="0dp" android:right="18dp" android:bottom="0dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/home_primary" />
            <corners android:radius="26dp" />
            <padding android:left="18dp" android:top="0dp" android:right="18dp" android:bottom="0dp" />
        </shape>
    </item>
</selector>
